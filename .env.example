# Contact form email delivery uses the serverless endpoint at /api/request-pricing.
# For local testing, run `pnpm dev:api` in one terminal and `pnpm dev` in another.

# Required SMTP settings for api/request-pricing.js.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional email settings.
VITE_DEFAULT_FROM_EMAIL=support@qinsights.ai
VITE_SUPPORT_TEAM_EMAILS=a.amir@qinsights.ai

# Optional direct landing-page Stratto CRM sync.
# Keep this server-side only. Do not expose it with a VITE_ prefix.
STRATTO_WEBHOOK_ENABLED=false
STRATTO_WEBHOOK_URL=

# Optional local API settings.
LOCAL_API_PORT=3001
LOCAL_API_URL=http://localhost:3001
