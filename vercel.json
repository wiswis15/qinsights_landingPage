{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.qinsights.ai"
        }
      ],
      "destination": "https://qinsights.ai/:path*",
      "permanent": true
    },
    {
      "source": "/features/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/conversational-analysis/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/conversational-analysis",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tired-of-ai-tools-that-overpromise-discover-qinsights/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tired-of-ai-tools-that-overpromise-discover-qinsights",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/https-www-qinsights-ai-from-coding-to-conversations-how-ai-transforms-qualitative-research/",
      "destination": "/from-coding-to-conversations-how-ai-transforms-qualitative-research",
      "permanent": true
    },
    {
      "source": "/https-www-qinsights-ai-from-coding-to-conversations-how-ai-transforms-qualitative-research",
      "destination": "/from-coding-to-conversations-how-ai-transforms-qualitative-research",
      "permanent": true
    },
    {
      "source": "/customer-information/",
      "destination": "/company-information",
      "permanent": true
    },
    {
      "source": "/customer-information",
      "destination": "/company-information",
      "permanent": true
    },
    {
      "source": "/desktop-app/",
      "destination": "/anonymizer",
      "permanent": true
    },
    {
      "source": "/desktop-app",
      "destination": "/anonymizer",
      "permanent": true
    }
  ]
}
